{
  "routes": [
    {
      "src": "^/index\\.html$",
      "headers": {
        "Location": "/"
      },
      "status": 308
    },
    {
      "src": "^/$",
      "dest": "/susan-damon-hub.html"
    },
    {
      "src": "^/(?:ops|source|quality|scripts|tmp)(?:/.*)?$",
      "status": 404
    },
    {
      "handle": "filesystem"
    }
  ]
}
